type Author {
    id: ID!
    name: String!
    nationality: String
    books: [Book]
}

type Book {
    id: ID!
    title: String!
    genre: String
    publication_year: Int
    author: Author
}

# Queries = GET (leitura)
type Query {
    allBooks: [Book]
    bookById(id: ID!): Book
    allAuthors: [Author]
    authorById(id: ID!): Author
}

# Mutations = POST/PUT/DELETE (escrita)
type Mutation {
    createAuthor(name: String!, nationality: String): Author
    createBook(title: String!, genre: String, publication_year: Int, authorId: ID!): Book
}